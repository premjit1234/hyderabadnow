# Copy to .env and fill in for local dev. In Docker (docker-compose.yml) these
# are read from the same .env file automatically; in production the same
# variables live in the server's .env next to docker-compose.yml.

# Required. Signs session cookies. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional — only needed to enable "Continue with Google". Without these set,
# the Google buttons redirect to a friendly error instead of crashing.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application), with these Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback   (local dev)
#   https://hyderabadnow.in/api/auth/google/callback (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required if GOOGLE_CLIENT_ID is set. The app's own public URL, no trailing
# slash — behind a reverse proxy (Caddy, nginx) Next.js can't reliably work
# this out from the incoming request, so it's set explicitly here and must
# exactly match one of the Authorized redirect URIs above (this + the
# /api/auth/google/callback suffix).
#   Local dev:  http://localhost:3000
#   Production: https://hyderabadnow.in
APP_URL=

# Optional — powers phone number OTP verification for anyone posting a
# listing (see lib/whatsappOtp.ts). Sent over WhatsApp, not SMS — WhatsApp
# Business API onboarding doesn't need India's DLT/TRAI registration, so it
# can be set up in days rather than the weeks-to-months DLT can take.
# Without these set, requesting a code fails with a clear "not set up yet"
# error instead of silently pretending to send one.
#   1. In your MSG91 dashboard, open the WhatsApp channel and complete Meta
#      Business verification + WhatsApp Business API (WABA) setup (needs
#      business documents — GST/PAN/incorporation proof — same as DLT, but
#      typically approved in days).
#   2. Create an "Authentication" category template — pick "Copy code" as
#      the delivery method (not auto-fill, which is for native apps). Once
#      Meta approves it, note the template name and language code MSG91
#      shows you.
#   3. Paste your auth key (Settings -> Authkey) below — same key as any
#      other MSG91 product, as long as its Rule has WhatsApp enabled — plus
#      your WhatsApp Business number and the template details from step 2.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_LANGUAGE_CODE=en

# Only needed if/when DLT registration completes and you switch phone
# verification back to plain SMS (see lib/sms.ts — not currently called from
# anywhere, kept ready to swap back in). Harmless to leave blank otherwise.
MSG91_TEMPLATE_ID=

# Set to "true" to log OTP codes to the server console instead of sending a
# real WhatsApp message, when the MSG91_WHATSAPP_* vars aren't set — useful
# for local/dev testing only. NEVER enable this in production: it would make
# phone verification meaningless.
OTP_DEV_MODE=

# Optional — powers the "still available?" stale-listing nudge email (see
# lib/email.ts and lib/staleListings.ts). Without these set, the periodic
# check still runs and auto-expires unconfirmed listings on schedule, it just
# can't email the owner first — a warning is logged instead.
#   1. Sign up at https://resend.com (free tier covers a small site easily).
#   2. Add and verify your sending domain there (a few DNS records).
#   3. Create an API key (Settings -> API Keys).
RESEND_API_KEY=
EMAIL_FROM=

# Optional — powers buying "featured listing" credits via Razorpay Checkout
# (see lib/razorpay.ts, app/actions.ts). Without these set, buying credits
# fails with a clear "not set up yet" error instead of silently pretending
# to charge someone.
#   1. Sign up at https://razorpay.com and complete KYC (needed before Live
#      mode keys work — Test mode keys work immediately, no KYC).
#   2. In the Dashboard, switch to Live mode (or stay in Test mode while
#      trying this out), then go to Account & Settings -> API Keys and click
#      Generate Key. Copy the Key ID immediately — the Key Secret is shown
#      once and never again, so save it right away.
#   3. In Account & Settings -> Webhooks, click + Add New Webhook with URL
#      https://hyderabadnow.in/api/payments/razorpay/webhook, subscribed to
#      the "payment.captured" event. The "Secret" field there is one you
#      make up yourself (any long random string) — paste that same value
#      below as RAZORPAY_WEBHOOK_SECRET.
# Test and Live mode each have their own separate Key ID/Secret/webhook —
# make sure the ones below match the mode you actually want live traffic to
# use.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
