# Copy to .env and fill in for local dev. In Docker (docker-compose.yml) these
# are read from the same .env file automatically; in production the same
# variables live in the server's .env next to docker-compose.yml.

# Required. Signs session cookies. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional — only needed to enable "Continue with Google". Without these set,
# the Google buttons redirect to a friendly error instead of crashing.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application), with these Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback   (local dev)
#   https://hyderabadnow.in/api/auth/google/callback (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
